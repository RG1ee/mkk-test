# PostgreSQL
APP_POSTGRES__HOST=localhost
APP_POSTGRES__PORT=5432
APP_POSTGRES__USER=postgres
APP_POSTGRES__PASSWORD=postgres
APP_POSTGRES__DB=payments

# RabbitMQ
APP_RABBITMQ__HOST=localhost
APP_RABBITMQ__PORT=5672
APP_RABBITMQ__USER=guest
APP_RABBITMQ__PASSWORD=guest

# API
APP_API_KEY=secret

# Payment processing
APP_PAYMENT__MAX_ATTEMPTS=3
APP_PAYMENT__GATEWAY_MIN_DELAY=2.0
APP_PAYMENT__GATEWAY_MAX_DELAY=5.0
APP_PAYMENT__GATEWAY_SUCCESS_RATE=0.9

# Webhook
APP_WEBHOOK__MAX_RETRIES=3
APP_WEBHOOK__TIMEOUT=5.0

# Outbox relay
APP_OUTBOX__POLL_INTERVAL=1.0
APP_OUTBOX__BATCH_SIZE=100
